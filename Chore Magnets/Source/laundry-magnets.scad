// Solid white shirt with green collar, placket and buttons; no pocket.
module shirt_outline() {
 polygon([[-0.49,0.47],[-0.31,0.55],[-0.24,0.66],[0.24,0.66],[0.31,0.55],[0.49,0.47],[0.46,-0.66],[-0.46,-0.66]]);
}
module shirt_filled() {
 difference() {
  shirt_outline();
  // Only cut interior details, preserving a solid outer edge.
  intersection() {
   offset(delta=-0.05) shirt_outline();
   difference() {
    offset(delta=0.008) icon_shirt();
    // Mask the square pocket while retaining the centre placket.
    translate([0.095,-0.39]) square([0.33,0.39]);
   }
  }
 }
}
module secondary_icon() {
 if(chore=="Shirt wash") shirt_filled();
 if(chore=="Trousers wash") icon_trousers();
 if(chore=="Wool wash") icon_wool();
 if(chore=="Bedding wash") icon_bedding();
 if(chore=="General wash") icon_general();
 if(chore=="Sports wash") icon_sports();
 if(chore=="Towel wash") icon_towel();
}
module detail() {
 translate([-4.15,3.95,tile_thickness-eps]) linear_extrude(height=relief_height+eps)
  scale(6.5) offset(delta=-0.002) icon_machine();
 secondary_scale=chore=="Shirt wash" ? 6.0 : chore=="Trousers wash" ? 4.5 : chore=="Wool wash" ? 6.6 : chore=="Bedding wash" ? 6.9 : chore=="General wash" ? 6.9 : chore=="Sports wash" ? 6.7 : 6.9;
 translate([4.15,4.0,tile_thickness-eps]) linear_extrude(height=relief_height+eps)
  scale(secondary_scale) offset(delta=chore=="Shirt wash" ? 0 : 0.001) secondary_icon();
 translate([0,0,tile_thickness-eps]) linear_extrude(height=letter_height+eps) {
  label=chore=="Shirt wash" ? "SHIRT" : chore=="Trousers wash" ? "TROUSERS" : chore=="Wool wash" ? "WOOL" : chore=="Bedding wash" ? "BEDDING" : chore=="General wash" ? "GENERAL" : chore=="Sports wash" ? "SPORTS" : "TOWEL";
  translate([0,-0.27*tile_size]) text(label,size=2/1.028,font=font_name,halign="center",valign="baseline",$fn=24);
  translate([0,-0.42*tile_size]) text("WASH",size=2/1.028,font=font_name,halign="center",valign="baseline",$fn=24);
 }
}
union() { base(); detail(); }
