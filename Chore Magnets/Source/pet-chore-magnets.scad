module poo_diagonal(is_cat=true) {
    translate([0.07,0.30]) scale(1.25) { if(is_cat) cat_poo_head(); else dog_poo_head(); }
    translate([0.12,-0.21]) scale(0.74) icon_scoop_reference();
}
// Enlarge the paw on the bag and the bone on the storage box in place.
module food_mark_regions() {
    translate([0.22,0.04]) square([0.16,0.16]);
    translate([-0.24,-0.19]) square([0.125,0.06]);
}
module enhanced_food() {
    difference() { icon_refill_food(); food_mark_regions(); }
    translate([0.30,0.12]) scale(1.3) translate([-0.30,-0.12]) intersection() {
        icon_refill_food(); translate([0.22,0.04]) square([0.16,0.16]);
    }
    translate([-0.1775,-0.16]) scale(1.3) translate([0.1775,0.16]) intersection() {
        icon_refill_food(); translate([-0.24,-0.19]) square([0.125,0.06]);
    }
}
// Stretch the storage box below its rim, leaving the bag and lid unchanged.
module taller_food_box() {
    cut=-0.10;
    intersection() { enhanced_food(); translate([-1,cut]) square([2,1]); }
    translate([0,cut]) scale([1,1.82]) translate([0,-cut])
        intersection() { enhanced_food(); translate([-1,-1]) square([2,1+cut]); }
}
module pen(points,w=0.025) {
    for(i=[0:len(points)-2]) hull() {translate(points[i]) circle(d=w); translate(points[i+1]) circle(d=w);}
}
// Keep the original litter and scoop above the rim, redraw a deeper tray and cat.
module taller_litter_box() {
    intersection() { icon_litter_box(); translate([-1,-0.045]) square([2,1.045]); }
    pen([[-0.46,-0.03],[-0.38,-0.32],[-0.34,-0.35],[0.34,-0.35],[0.38,-0.32],[0.46,-0.03]],0.028);
    // Reuse the face from the cat-poo tile at a smaller scale.
    translate([0.156,-0.19]) scale(0.598) cat_poo_head();
}

// Bring the walker and dog inward before enlarging the shared icon.
// Separate the walker and dog; hide the walker outline where the dog is in front.
module walk_person() { intersection() { icon_walk_dog(); translate([-1,-1]) square([0.895,2]); } }
module walk_animal() { intersection() { icon_walk_dog(); translate([-0.02,-1]) square([1.02,2]); } }
module closer_walk_dog() {
    difference() {
        translate([0.098,0]) walk_person();
        offset(r=0.012) translate([-0.098,0]) walk_animal();
    }
    translate([-0.098,0]) walk_animal();
    // Leash runs from the walker's hand to the dog's collar.
    pen([[-0.008,0.015],[-0.025,0.10],[0.025,0.16],[0.105,0.15],[0.17,0.10],[0.17,0.04],[0.145,-0.025]],0.023);
}

module chosen_icon() {
 if(chore == "Cat poo") poo_diagonal(true);
 if(chore == "Dog poo") poo_diagonal(false);
 if(chore == "Refill food") icon_approved_food_bin();
 if(chore == "Dry dog") icon_dry_dog();
 if(chore == "Wash dog") icon_wash_dog();
 if(chore == "Litter box") taller_litter_box();
 if(chore == "Walk dog") icon_walk_reference();
