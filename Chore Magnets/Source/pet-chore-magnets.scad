// Pet chore tiles. Self-contained vector icon traces from the selected concepts.
// Units: mm. Print face up. Requires Arial Bold to regenerate the labels.
/* [Chore] */
chore = "Cat poo"; // [Cat poo,Dog poo,Refill food,Dry dog,Wash dog,Litter box,Walk dog]
/* [Dimensions] */
tile_size = 20; // Set to 11.5, 16 or 20 mm per chore
tile_thickness = 10;
relief_height = 0.8;
letter_height = 0.6;
magnet_diameter = 6;
magnet_thickness = 2;
magnet_clearance = 0.05; // Tested 6.05 mm pocket for the user's magnets
pocket_extra_depth = 0.1;
notch_width = 1.6;
notch_extension = 1.2;
large_magnet_spacing = 9.4;
font_name = "Arial:style=Bold";
/* [Hidden] */
eps = 0.02;
pocket_d = magnet_diameter + magnet_clearance;
pocket_depth = magnet_thickness + pocket_extra_depth;
$fa = 4; $fs = 0.25;
assert(tile_size >= 11.5 && tile_thickness > pocket_depth+0.8, "Check tile dimensions and pocket depth.");
assert(tile_size < 20 || large_magnet_spacing/2+pocket_d/2 < tile_size/2-2, "Magnet pockets extend too close to edge.");
assert(tile_size < 20 || large_magnet_spacing-pocket_d-2*notch_extension > 0.6, "The two magnet notches are too close.");
assert(chore == "Cat poo" || chore == "Dog poo" || chore == "Refill food" || chore == "Dry dog" || chore == "Wash dog" || chore == "Litter box" || chore == "Walk dog", "Select one of the seven pet chores.");
module magnet_pocket(x) {
 dir = x > 0 ? -1 : 1;
 translate([x,0,-eps]) union() {
  cylinder(d=pocket_d,h=pocket_depth+eps);
  translate([dir*(pocket_d/2-0.5+notch_extension/2),0,(pocket_depth+eps)/2])
   cube([notch_extension+1,notch_width,pocket_depth+eps],center=true);
 }
}
module base() {
 difference() {
  linear_extrude(height=tile_thickness) offset(r=1.6) square([tile_size-3.2,tile_size-3.2],center=true);
  for(x = tile_size >= 20 ? [-large_magnet_spacing/2,large_magnet_spacing/2] : [0]) magnet_pocket(x);
 }
}
