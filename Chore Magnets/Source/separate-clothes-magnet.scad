// Fill the basket and folded clothes, retaining the slots and a fold as negative space.
module rounded_slot(x, y, width, height) {
 translate([x,y]) hull() {
  translate([0,(height-width)/2]) circle(d=width,$fn=24);
  translate([0,-(height-width)/2]) circle(d=width,$fn=24);
 }
}
module print_icon() {
 difference() {
  union() {
   offset(delta=0.006) icon_separate_clothes();
   // The filled basket merges into the traced outer border.
   polygon([[-0.445,0.095],[0.445,0.095],[0.35,-0.30],[0.29,-0.35],[-0.29,-0.35],[-0.35,-0.30]]);
   // The folded clothes retain the silhouette of the reference.
   hull() { for(x=[-0.32,0.32]) translate([x,0.264]) circle(r=0.075,$fn=40); }
  }
  for(x=[-0.244,-0.087,0.070,0.227]) rounded_slot(x,-0.110,0.065,0.225);
  hull() { for(x=[-0.27,0.50]) translate([x,0.265]) circle(d=0.025,$fn=20); }
 }
}

// The label uses the same letter height on both lines.
module detail() {
 translate([0,2.50,tile_thickness-eps]) linear_extrude(height=relief_height+eps)
  scale(11.4) print_icon();
 translate([0,0,tile_thickness-eps]) linear_extrude(height=letter_height+eps) {
  translate([0,-0.285*tile_size]) text("SEPARATE",size=2/1.028,font=font_name,halign="center",valign="baseline",$fn=24);
  translate([0,-0.445*tile_size]) text("CLOTHES",size=2/1.028,font=font_name,halign="center",valign="baseline",$fn=24);
 }
}
union() { base(); detail(); }
