// Separate clothes chore magnet: 16 mm yellow body with black raised details.
// Self-contained icon geometry traced from approved 2D concepts and reference.
// Units: mm. Arial Bold must be installed to regenerate the labels.
/* [Chore] */
chore="Separate clothes";
/* [Dimensions] */
tile_size=16;
tile_thickness=10;
relief_height=0.8;
letter_height=0.6;
magnet_diameter=6; // Set to 5 for the 5 x 2 mm version
magnet_thickness=2;
magnet_clearance=0.05; // Total diameter clearance: test fit for 5 mm magnets
pocket_extra_depth=0.1;
notch_width=1.6;
notch_extension=1.2;
font_name="Arial:style=Bold";
/* [Hidden] */
eps=0.02;
pocket_d=magnet_diameter+magnet_clearance;
pocket_depth=magnet_thickness+pocket_extra_depth;
$fa=4; $fs=0.25;
assert(tile_size>=16 && tile_thickness>=pocket_depth+0.8, "Check the tile size and magnet pocket depth.");
assert(magnet_diameter>0 && magnet_thickness>0 && magnet_clearance>=0 && pocket_extra_depth>=0, "Check magnet dimensions and clearance.");
assert(pocket_d/2+notch_extension<tile_size/2-1, "Magnet notch is too close to the tile edge.");

module magnet_pocket() {
 translate([0,0,-eps]) union() {
  cylinder(d=pocket_d,h=pocket_depth+eps);
  translate([pocket_d/2-0.5+notch_extension/2,0,(pocket_depth+eps)/2]) cube([notch_extension+1,notch_width,pocket_depth+eps],center=true);
 }
}
module base() { difference() { linear_extrude(height=tile_thickness) offset(r=1.6) square([tile_size-3.2,tile_size-3.2],center=true); magnet_pocket(); } }
