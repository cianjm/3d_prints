// Simplify Cian's expression to two dot eyes and one curved smile.
module cian_face_simplified() {
 union() {
  difference() {
   icon_cian_face();
   // Remove the original brows, eyes, smile and lower lip, keeping the nose.
   translate([-0.30,-0.11]) square([0.60,0.20]);
   translate([-0.19,-0.47]) square([0.38,0.17]);
  }
  for(x=[-0.165,0.165]) translate([x,-0.047]) circle(r=0.037,$fn=32);
  for(i=[0:3]) hull() {
   smile=[[-0.15,-0.33],[-0.09,-0.375],[0,-0.39],[0.09,-0.375],[0.15,-0.33]];
   translate(smile[i]) circle(d=0.040,$fn=20);
   translate(smile[i+1]) circle(d=0.040,$fn=20);
  }
 }
}

