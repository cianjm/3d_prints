// Chore bin magnets. Dimensions in mm. Print face up.
// Four 16 mm tiles use one 6 x 2 mm magnet; the 20 mm food tile uses two.
// Icon contours are embedded from the supplied reference pictures.

/* [Chore] */
chore = "Upstairs bins"; // [Upstairs bins,Dog poo bin,Normal bin,Recycling bin,Food bin]
font_name = "Arial:style=Bold"; // Installed font needed to regenerate identical text

/* [Dimensions] */
small_tile = 16;
food_tile = 20;
tile_thickness = 10;
relief_height = 0.8;
letter_height = 0.6;
magnet_diameter = 6;
magnet_thickness = 2;
magnet_clearance = 0.05; // Total diametral clearance; test the fit
pocket_depth_extra = 0.1;
large_magnet_spacing = 9.4;
notch_width = 1.6; // Screwdriver slot width
notch_extension = 1.2; // Distance beyond the round pocket
bin_icon_scale = 1.2; // Enlarges bin outline and inner symbol together
bin_outer_width_factor = 0.8; // Narrow the outside without changing the inner symbol
bin_side_line_factor = 1.5; // Side and bottom stroke thickness

/* [Hidden] */
eps=0.02;
tile = chore == "Food bin" ? food_tile : small_tile;
k=tile/25;
pocket_d=magnet_diameter+magnet_clearance;
pocket_depth=magnet_thickness+pocket_depth_extra;
$fa=4; $fs=0.25;
assert(tile>=16 && tile_thickness>=pocket_depth+0.8, "Check tile size and magnet pocket depth.");
assert(chore == "Upstairs bins" || chore == "Dog poo bin" || chore == "Normal bin" || chore == "Recycling bin" || chore == "Food bin", "Select a valid chore.");
assert(magnet_diameter>0 && magnet_thickness>0 && magnet_clearance>=0 && pocket_depth_extra>=0, "Check magnet dimensions.");
assert(chore != "Food bin" || large_magnet_spacing/2+pocket_d/2<tile/2-2, "Magnet pockets exceed the tile edge.");

module magnet_pocket(x) {
 dir = x > 0 ? -1 : 1;
 translate([x,0,-eps]) union() {
  cylinder(d=pocket_d,h=pocket_depth+eps);
  translate([dir*(pocket_d/2-0.5+notch_extension/2),0,(pocket_depth+eps)/2])
   cube([notch_extension+1,notch_width,pocket_depth+eps],center=true);
 }
}
assert(notch_width>0 && notch_extension>0, "The screwdriver notch must have positive dimensions.");
assert(large_magnet_spacing - pocket_d - 2*notch_extension > 0.6, "Leave at least 0.6 mm between the two slots.");

module stroke(points, width) { for(i=[0:len(points)-2]) hull() { translate(points[i]) circle(d=width); translate(points[i+1]) circle(d=width); } }
module bin_icon() {
 // Narrow only the horizontal positions. Stroke width remains independent.
 stroke([[-6.1*bin_outer_width_factor,6.4],[-5.6*bin_outer_width_factor,-0.9],[-5.35*bin_outer_width_factor,-1.25],[5.35*bin_outer_width_factor,-1.25],[5.6*bin_outer_width_factor,-0.9],[6.1*bin_outer_width_factor,6.4]],0.55*bin_side_line_factor);
 stroke([[-6.7*bin_outer_width_factor,7.35],[6.7*bin_outer_width_factor,7.35]],1.15);
 scale([bin_outer_width_factor,1]) difference() { translate([0,7.35]) scale([1,0.62]) circle(r=3.2); translate([0,7.35]) scale([1,0.62]) circle(r=2.55); translate([-4,3.2]) square([8,4.15]); }
}
module stairs() { stroke([[-3,-0.05],[-2,-0.05],[-2,1],[-1,1],[-1,2],[0,2],[0,3],[1,3],[1,4],[2,4]],0.55); polygon([[1.1,5.25],[2.1,6.3],[3.1,5.25],[2.5,5.25],[2.5,4.5],[1.7,4.5],[1.7,5.25]]); }
