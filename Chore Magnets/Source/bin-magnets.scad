module symbol() {
 if(chore == "Upstairs bins") stairs();
 else translate([0,2.65]) {
   if(chore == "Dog poo bin") offset(delta=0.10) scale(5.0) ref_poo();
   if(chore == "Normal bin") offset(delta=0.10) scale(4.4) ref_bag();
   if(chore == "Recycling bin") scale(5.8*1.15) ref_recycle();
   if(chore == "Food bin") offset(delta=0.09) scale(5.2) ref_food();
 }
}
module label_line(t,y,size) { translate([0,y]) text(t,size=size,font=font_name,halign="center",valign="baseline",$fn=24); }
module bin_graphic() { translate([0,3]) scale(bin_icon_scale) translate([0,-3]) union() { bin_icon(); symbol(); } }
module label() {
 // Arial Bold actual capital height is about 1.028 times the OpenSCAD size.
 target_text_height = chore == "Recycling bin" ? 1.8 : 2.0;
 label_size = target_text_height / (1.028*k);
 label_line(chore == "Upstairs bins" ? "UPSTAIRS" : chore == "Dog poo bin" ? "DOG POO" : chore == "Normal bin" ? "NORMAL" : chore == "Recycling bin" ? "RECYCLING" : "FOOD", -0.285*tile/k, label_size);
 label_line(chore == "Upstairs bins" ? "BINS" : "BIN",-0.445*tile/k,label_size);
}
union() {
 difference() {
 linear_extrude(height=tile_thickness) offset(r=1.6) square([tile-3.2,tile-3.2],center=true);
 for(x=chore=="Food bin" ? [-large_magnet_spacing/2,large_magnet_spacing/2] : [0]) magnet_pocket(x);
 }
 translate([0,0,tile_thickness-eps]) linear_extrude(height=relief_height+eps) scale(k) bin_graphic();
 translate([0,0,tile_thickness-eps]) linear_extrude(height=letter_height+eps) scale(k) label();
}
